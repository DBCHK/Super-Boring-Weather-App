<?xml version="1.0" encoding="utf-8"?>
<!-- 3-day forecast — white card, precip + hi/lo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_white"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.08"
        android:text="3-DAY · SEATTLE"
        android:textColor="#FF8E8E93"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- Day 0 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day0_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="TODAY"
                android:textColor="#FF8E8E93"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_icon_circle">

                <ImageView
                    android:id="@+id/day0_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_sun" />
            </FrameLayout>

            <TextView
                android:id="@+id/day0_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="22°"
                android:textColor="#FF1C1C1E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day0_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="12°"
                android:textColor="#FF8E8E93"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/day0_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="20%"
                android:textColor="#FF007AFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="SAT"
                android:textColor="#FF8E8E93"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_icon_circle">

                <ImageView
                    android:id="@+id/day1_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_sun" />
            </FrameLayout>

            <TextView
                android:id="@+id/day1_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="20°"
                android:textColor="#FF1C1C1E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day1_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="11°"
                android:textColor="#FF8E8E93"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/day1_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="40%"
                android:textColor="#FF007AFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="SUN"
                android:textColor="#FF8E8E93"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_icon_circle">

                <ImageView
                    android:id="@+id/day2_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_cloud" />
            </FrameLayout>

            <TextView
                android:id="@+id/day2_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="19°"
                android:textColor="#FF1C1C1E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day2_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="10°"
                android:textColor="#FF8E8E93"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/day2_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="10%"
                android:textColor="#FF007AFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
